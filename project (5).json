    "index.html": {
      "content": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Document</title>\n</head>\n\n\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: Arial, sans-serif;\n            background: linear-gradient(135deg, #050505, #071a35, #0b3d68);\n            color: white;\n            min-height: 100vh;\n            overflow-x: hidden;\n        }\n\n        .container {\n            text-align: center;\n            padding: 70px 20px;\n        }\n\n        .birthday {\n            font-size: 60px;\n            margin-bottom: 20px;\n            animation: glow 2s infinite alternate;\n        }\n\n        h1 {\n            font-size: 55px;\n            color: #4db8ff;\n            margin-bottom: 15px;\n        }\n\n        h2 {\n            font-size: 30px;\n            margin-bottom: 30px;\n        }\n\n        .card {\n            max-width: 650px;\n            margin: auto;\n            padding: 35px;\n            background: rgba(255,255,255,0.08);\n            border: 1px solid rgba(255,255,255,0.2);\n            border-radius: 25px;\n            backdrop-filter: blur(10px);\n            box-shadow: 0 10px 40px rgba(0,0,0,0.5);\n        }\n\n        .card p {\n            font-size: 20px;\n            line-height: 1.7;\n            color: #ddd;\n        }\n\n        button {\n            margin-top: 30px;\n            padding: 15px 35px;\n            border: none;\n            border-radius: 30px;\n            background: #168cff;\n            color: white;\n            font-size: 18px;\n            cursor: pointer;\n            transition: 0.3s;\n        }\n\n        button:hover {\n            transform: scale(1.08);\n            background: #006bd6;\n        }\n\n        #message {\n            display: none;\n            margin-top: 25px;\n            font-size: 24px;\n            color: #4db8ff;\n            animation: appear 1s;\n        }\n\n        .balloon {\n            position: fixed;\n            bottom: -100px;\n            font-size: 45px;\n            animation: fly 7s linear infinite;\n        }\n\n        .b1 { left: 10%; animation-delay: 1s; }\n        .b2 { left: 30%; animation-delay: 3s; }\n        .b3 { left: 55%; animation-delay: 0s; }\n        .b4 { left: 80%; animation-delay: 2s; }\n\n        @keyframes fly {\n            0% {\n                bottom: -100px;\n                transform: rotate(0deg);\n            }\n            100% {\n                bottom: 110%;\n                transform: rotate(20deg);\n            }\n        }\n\n        @keyframes glow {\n            from {\n                text-shadow: 0 0 10px #168cff;\n            }\n            to {\n                text-shadow: 0 0 35px #4db8ff;\n            }\n        }\n\n        @keyframes appear {\n            from {\n                opacity: 0;\n                transform: scale(0.5);\n            }\n            to {\n                opacity: 1;\n                transform: scale(1);\n            }\n        }\n\n        .footer {\n            margin-top: 50px;\n            color: #aaa;\n        }\n\n        @media (max-width: 600px) {\n            .birthday {\n                font-size: 45px;\n            }\n\n            h1 {\n                font-size: 38px;\n            }\n\n            h2 {\n                font-size: 24px;\n            }\n\n            .card {\n                padding: 25px;\n            }\n        }\n    </style>\n\n\n<body>\n\n    <!-- Sharlar -->\n    <div class=\"balloon b1\">🎈</div>\n    <div class=\"balloon b2\">🎈</div>\n    <div class=\"balloon b3\">🎈</div>\n    <div class=\"balloon b4\">🎈</div>\n\n    <div class=\"container\">\n\n        <div class=\"birthday\">🎂</div>\n\n        <h1>HAPPY BIRTHDAY!</h1>\n\n        <h2>🎉 Muhammadbobur🎉</h2>\n\n        <div class=\"card\">\n\n            <p>\n                Bugungi kun sen uchun eng chiroyli va\n                unutilmas kunlardan biri bo‘lsin! ❤️\n            </p>\n\n            <br>\n\n            <p>\n                Senga mustahkam sog‘liq, katta baxt,\n                omad va barcha orzularing amalga oshishini\n                tilayman. Har doim kulib yur! ✨\n            </p>\n\n            <button onclick=\"showMessage()\">\n                🎁 Sovg‘ani ochish\n            </button>\n\n            <div id=\"message\">\n                🎉 Yana bir bor TUG‘ILGAN KUNING BILAN! 🎉\n                <br><br>\n                🖤 Doimo baxtli bo‘l!\n            </div>\n\n        </div>\n\n        <div class=\"footer\">\n            Made with ❤️ for you\n        </div>\n\n    </div>\n\n    <script>\n        function showMessage() {\n            document.getElementById(\"message\").style.display = \"block\";\n\n            // Konfetti\n            for (let i = 0; i < 50; i++) {\n                let confetti = document.createElement(\"div\");\n\n                confetti.innerHTML = \"✨\";\n                confetti.style.position = \"fixed\";\n                confetti.style.left = Math.random() * 100 + \"vw\";\n                confetti.style.top = \"-20px\";\n                confetti.style.fontSize = \"25px\";\n                confetti.style.animation =\n                    \"fall 3s linear forwards\";\n\n                document.body.appendChild(confetti);\n\n                setTimeout(() => {\n                    confetti.remove();\n                }, 3000);\n            }\n        }\n\n        const style = document.createElement(\"style\");\n\n        style.innerHTML = `\n            @keyframes fall {\n                from {\n                    transform: translateY(0) rotate(0deg);\n                }\n                to {\n                    transform: translateY(110vh) rotate(360deg);\n                }\n            }\n        `;\n\n        document.head.appendChild(style);\n    </script>\n\n</body>\n</html>",
      "type": "html"
    },
